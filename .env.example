# ==========================================
# RackNerd 促销与补货监控系统环境变量配置模板
# 复制此文件为 .env 并填入真实配置即可在本地调试
# ==========================================

# 1. 企业微信机器人 Webhook 地址（发现新优惠/补货时即时推送提醒）
QYWX_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your_webhook_key_here

# 2. 集中管控中枢配置（云端由 GitHub Secrets 自动注入）
CHECKIN_HUB_URL=https://checkin.wwcoder.top
CHECKIN_HUB_TOKEN=your_checkin_hub_token_here
